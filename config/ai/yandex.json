{
  "version": 1,
  "policy": {
    "allowedConnections": [
      "yandex"
    ],
    "features": {
      "webSearch": false,
      "websiteFetch": false,
      "browserSpeechRecognition": false,
      "serverSpeechRecognition": false
    }
  },
  "connections": {
    "yandex": {
      "enabled": true,
      "adapter": "yandex-openai-compatible",
      "baseUrl": "https://ai.api.cloud.yandex.net/v1",
      "credentialsEnv": "YANDEX_AI_API_KEY",
      "folderIdEnv": "YANDEX_AI_FOLDER_ID"
    }
  },
  "models": {
    "yandex-text": {
      "enabled": true,
      "label": "Yandex AI Studio",
      "connectionId": "yandex",
      "upstreamModelIdEnv": "YANDEX_AI_TEXT_MODEL_URI",
      "capabilities": [
        "text",
        "structuredOutput",
        "tools",
        "streaming"
      ]
    },
    "yandex-vision": {
      "enabled": false,
      "label": "Yandex Vision",
      "connectionId": "yandex",
      "upstreamModelIdEnv": "YANDEX_AI_VISION_MODEL_URI",
      "capabilities": [
        "text",
        "image"
      ]
    }
  },
  "tasks": {
    "chat": {
      "enabled": true,
      "allowedModels": [
        "yandex-text"
      ],
      "fallbackModels": [],
      "defaultModel": "yandex-text"
    },
    "analytics": {
      "enabled": true,
      "allowedModels": [
        "yandex-text"
      ],
      "fallbackModels": [],
      "defaultModel": "yandex-text"
    },
    "cards": {
      "enabled": true,
      "allowedModels": [
        "yandex-text"
      ],
      "fallbackModels": [],
      "defaultModel": "yandex-text"
    },
    "deals": {
      "enabled": true,
      "allowedModels": [
        "yandex-text"
      ],
      "fallbackModels": [],
      "defaultModel": "yandex-text"
    },
    "orderRequest": {
      "enabled": true,
      "allowedModels": [
        "yandex-text"
      ],
      "fallbackModels": [],
      "defaultModel": "yandex-text"
    },
    "chatSummary": {
      "enabled": true,
      "allowedModels": [
        "yandex-text"
      ],
      "fallbackModels": [],
      "defaultModel": "yandex-text"
    },
    "companyResearch": {
      "enabled": false,
      "defaultModel": "yandex-text",
      "allowedModels": [
        "yandex-text"
      ],
      "fallbackModels": []
    },
    "companyExtraction": {
      "enabled": false,
      "defaultModel": "yandex-text",
      "allowedModels": [
        "yandex-text"
      ],
      "fallbackModels": []
    },
    "parseText": {
      "enabled": true,
      "allowedModels": [
        "yandex-text"
      ],
      "fallbackModels": [],
      "defaultModel": "yandex-text"
    },
    "parsePdf": {
      "enabled": false,
      "defaultModel": "yandex-text",
      "allowedModels": [
        "yandex-text"
      ],
      "fallbackModels": []
    },
    "parseImage": {
      "enabled": false,
      "defaultModel": "yandex-text",
      "allowedModels": [
        "yandex-text"
      ],
      "fallbackModels": []
    },
    "parseAudio": {
      "enabled": false,
      "defaultModel": "yandex-text",
      "allowedModels": [
        "yandex-text"
      ],
      "fallbackModels": []
    },
    "parseVideo": {
      "enabled": false,
      "defaultModel": "yandex-text",
      "allowedModels": [
        "yandex-text"
      ],
      "fallbackModels": []
    },
    "parseOffice": {
      "enabled": true,
      "allowedModels": [
        "yandex-text"
      ],
      "fallbackModels": [],
      "defaultModel": "yandex-text"
    },
    "orgAttribution": {
      "enabled": true,
      "allowedModels": [
        "yandex-text"
      ],
      "fallbackModels": [],
      "defaultModel": "yandex-text"
    },
    "webSearch": {
      "enabled": false,
      "defaultModel": "yandex-text",
      "allowedModels": [
        "yandex-text"
      ],
      "fallbackModels": []
    },
    "describeImage": {
      "enabled": false,
      "defaultModel": "yandex-vision",
      "allowedModels": [
        "yandex-vision"
      ],
      "fallbackModels": []
    }
  },
  "preprocessing": {
    "images": "vision",
    "pdf": "ocr",
    "pdfMaxPages": 10,
    "audio": "speechkit",
    "video": "disabled",
    "maxMediaSeconds": 180
  },
  "services": {
    "speech": {
      "enabled": false,
      "connectionId": "yandex",
      "credentialsEnv": "YANDEX_SPEECH_API_KEY"
    },
    "search": {
      "enabled": false,
      "connectionId": "yandex",
      "credentialsEnv": "YANDEX_SEARCH_API_KEY"
    },
    "ocr": {
      "enabled": false,
      "connectionId": "yandex",
      "credentialsEnv": "YANDEX_OCR_API_KEY"
    }
  }
}
