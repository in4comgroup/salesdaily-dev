{
  "version": 2,
  "features": {
    "webSearch": true,
    "websiteFetch": false,
    "browserSpeechRecognition": false,
    "serverSpeechRecognition": true
  },
  "files": {
    "images": "vision",
    "maxMediaSeconds": 180,
    "pdfMaxPages": 10
