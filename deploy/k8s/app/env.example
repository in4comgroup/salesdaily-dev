# Runtime env for the `crm-env` Secret. Copy OUTSIDE the repo, fill in,
#   kubectl -n salesdaily create secret generic crm-env --from-env-file=<file>
# and delete the filled copy. NEXT_PUBLIC_* are build args (GitHub repo
# variables), not listed here.
#
# ⚠ kubectl takes everything after `=` literally: no quotes, no trailing
# comments, no spaces around `=`. Comments go on their own lines only.

# ── Core ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASS@HOST:5432/DBNAME?sslmode=require
# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://dev.salesdaily.ru
# SAME value as today — losing it bricks every stored source credential
CREDENTIALS_ENCRYPTION_KEY=
# openssl rand -base64 32
CRON_SECRET=

# ── LLM ──────────────────────────────────────────────────────────────────
# Only required when the legacy Gateway connection is enabled.
AI_GATEWAY_API_KEY=
# Only required when the Yandex connection is enabled.
YANDEX_AI_API_KEY=
YANDEX_AI_FOLDER_ID=
# Full URI from Model Gallery, belonging to the folder above.
YANDEX_AI_TEXT_MODEL_URI=
# Required only for enabled image preprocessing.
YANDEX_AI_VISION_MODEL_URI=
# Required only when their respective services are enabled (may share a key
# with AI if that key and service account have all required permissions).
YANDEX_OCR_API_KEY=
YANDEX_SPEECH_API_KEY=
YANDEX_SEARCH_API_KEY=
# Optional: daily model prices from the Yandex Billing API (Settings → «Модели»).
# Service-account AUTHORIZED key (JSON with a private key — an API key does NOT
# work), base64-encoded on one line: base64 -i key.json | tr -d '\n'.
# The service account needs role billing.accounts.viewer on the billing account.
# Leave both out to enter prices by hand.
YANDEX_BILLING_SA_KEY=
YANDEX_BILLING_ACCOUNT_ID=
# AI_CONFIG_PATH is set by Deployment to /etc/crm-ai/ai-config.json.
# The non-secret JSON is mounted from ConfigMap crm-ai-config.

# ── Email ────────────────────────────────────────────────────────────────
EMAIL_PROVIDER=nylas
# required even with nylas (the Resend client is built at import)
RESEND_API_KEY=
RESEND_FROM=
NYLAS_API_KEY=
NYLAS_API_URI=
NYLAS_CLIENT_ID=
NYLAS_CALLBACK_URI=
NYLAS_GRANT_ID=

# ── Object storage (h3llo S3, any S3-compatible) ─────────────────────────
S3_ENDPOINT=https://storage.h3llo.cloud
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
# Optional — only if the store names another region in an
# AuthorizationHeaderMalformed error (default us-east-1).
# S3_REGION=

# ── Telegram bootstrap bot (optional) ────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET_TOKEN=
